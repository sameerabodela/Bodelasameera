import java.util.Scanner;
public class Main {
    static int max = 0;
    static void findSubsequence(String s, int index, String curr) {
        if (index == s.length()) {
            if (isPalindrome(curr)) {
                max = Math.max(max, curr.length());
            }
            return;
        }
        findSubsequence(s, index + 1, curr + s.charAt(index));
        findSubsequence(s, index + 1, curr);
    }
    static boolean isPalindrome(String str) {
        int i = 0;
        int j = str.length() - 1;
        while (i < j) {
            if (str.charAt(i) != str.charAt(j)) {
                return false;
            }
            i++;
            j--;
        }
        return true;
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s = sc.next();
        findSubsequence(s, 0, "");
        System.out.println(max);
    }
}
